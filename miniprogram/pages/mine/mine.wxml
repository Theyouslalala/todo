<view class="container">
  <view class="user-card bg-gradient-primary">
    <view class="user-avatar">{{userInfo.name[0] || '?'}}</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.name || '未登录'}}</text>
      <text class="user-role">{{roleName}}</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item hover-light" bindtap="goFamily">
      <view class="menu-icon-circle" style="background: #e6f0ff;">
        <text class="menu-icon-text" style="color: #4A90D9;">家</text>
      </view>
      <text class="menu-text">家庭成员</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item hover-light" bindtap="goActivityLog">
      <view class="menu-icon-circle" style="background: #e6ffe6;">
        <text class="menu-icon-text" style="color: #52c41a;">志</text>
      </view>
      <text class="menu-text">操作日志</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item hover-light" bindtap="goRecycleBin">
      <view class="menu-icon-circle" style="background: #fff7e6;">
        <text class="menu-icon-text" style="color: #faad14;">收</text>
      </view>
      <text class="menu-text">回收站</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item hover-light" bindtap="goSettings">
      <view class="menu-icon-circle" style="background: #f0f0f0;">
        <text class="menu-icon-text" style="color: #666;">设</text>
      </view>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version-area" bindtap="onVersionTap">
    <text class="version-text">v1.0.0</text>
  </view>
</view>
