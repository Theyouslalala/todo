.container { padding: 24rpx; }

.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 24rpx 12rpx;
}

.form-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item:last-child { border-bottom: none; }

.label {
  font-size: 30rpx;
  color: #333;
  min-width: 120rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

.role-options {
  display: flex;
  gap: 16rpx;
}

.role-tag {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.role-tag.active {
  background: #e6f0ff;
  color: #4A90D9;
  font-weight: 600;
}

.link { cursor: pointer; }
.arrow { color: #ccc; font-size: 32rpx; }

.submit-area { padding: 40rpx 0; }

.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
