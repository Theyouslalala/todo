<view class="container">
  <view class="section">
    <view class="section-title">个人信息</view>
    <view class="form-item">
      <text class="label">昵称</text>
      <input class="input" placeholder="输入昵称" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="label">角色</text>
      <view class="role-options">
        <view wx:for="{{roles}}" wx:key="value"
          class="role-tag {{role === item.value ? 'active' : ''}}"
          bindtap="onRoleSelect" data-value="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">其他</view>
    <view class="form-item link" bindtap="onAbout">
      <text class="label">关于</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="submit-area">
    <button class="btn-primary" bindtap="onSave">保存</button>
  </view>
</view>
