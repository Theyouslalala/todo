.container { min-height: 100vh; background: #f5f5f5; }

/* Guide section for new users */
.guide-section {
  background: #fff;
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  text-align: center;
}
.guide-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.guide-title { font-size: 32rpx; font-weight: 600; color: #333; display: block; margin-bottom: 8rpx; }
.guide-desc { font-size: 26rpx; color: #999; display: block; margin-bottom: 32rpx; }
.guide-divider { display: flex; align-items: center; margin: 24rpx 0; }
.divider-line { flex: 1; height: 1rpx; background: #eee; }
.divider-text { padding: 0 16rpx; font-size: 24rpx; color: #ccc; }

/* Invite code section */
.invite-section { background: #fff; margin: 24rpx; padding: 32rpx; border-radius: 16rpx; text-align: center; }
.invite-label { font-size: 26rpx; color: #999; display: block; margin-bottom: 12rpx; }
.invite-code { font-size: 48rpx; font-weight: 700; color: #4A90D9; letter-spacing: 8rpx; display: block; margin-bottom: 16rpx; }
.btn-copy { background: #f5f5f5; color: #4A90D9; font-size: 28rpx; border-radius: 8rpx; display: inline-block; padding: 8rpx 32rpx; }

/* Members section */
.members-section { background: #fff; margin: 24rpx; padding: 24rpx; border-radius: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }
.member-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.member-item:last-child { border-bottom: none; }
.member-avatar { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; background: #e6f0ff; color: #4A90D9; border-radius: 50%; margin-right: 16rpx; font-weight: 600; }
.member-name { flex: 1; font-size: 30rpx; color: #333; }
.member-role { font-size: 24rpx; color: #999; }
.role-admin { color: #4A90D9; font-weight: 600; }

/* Join section */
.join-section { background: #fff; margin: 24rpx; padding: 24rpx; border-radius: 16rpx; }
.join-input-row { display: flex; gap: 16rpx; align-items: center; }
.join-input { flex: 1; font-size: 28rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx 20rpx; }
.btn-join { flex-shrink: 0; }

.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}
