.todo-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.2s ease;
  position: relative;
}

.todo-card.completed {
  opacity: 0.65;
  background: #fafafa;
}

.todo-card.completed .card-title {
  text-decoration: line-through;
  color: #bbb;
}

.color-bar {
  width: 6rpx;
  min-height: 100%;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  padding: 24rpx;
  min-width: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-category {
  font-size: 22rpx;
  color: #4A90D9;
  background: #e6f0ff;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.card-body {
  margin-top: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-quantity {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.card-date {
  font-size: 24rpx;
  color: #999;
}

.card-lunar {
  font-size: 22rpx;
  color: #b8b8b8;
}

.card-time {
  font-size: 24rpx;
  color: #999;
}

.card-assignee {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.assignee-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e6f0ff;
  color: #4A90D9;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
}

.action-complete {
  background: #e6f0ff;
  color: #4A90D9;
}

.action-delete {
  background: #fff0f0;
  color: #ff4d4f;
}
